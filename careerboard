#!/bin/bash
# Career Decision Board control panel. Run from anywhere:  ./careerboard <command>
#   now        run a Gmail scan immediately
#   build      rebuild the dashboard artifacts from the store
#   seed       load clearly-labeled sample data (try the board in 30 seconds)
#   status     show scheduler agents, last scan time, server health
#   logs       follow today's scan log
#   open       open the dashboard in your browser
#   start      (re)load the launchd agents (server + scheduled scan) [macOS]
#   stop       unload the launchd agents [macOS]
#   uninstall  stop and remove the launchd agents [macOS]
#   test       run the unit-test suite
set -u
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENG="$REPO/engine"
U=$(id -u)
PY="python3"

case "${1:-}" in
  now)
    echo "Triggering a scan now (reads Gmail via the Gmail API)…"
    if command -v launchctl >/dev/null 2>&1; then
      launchctl kickstart -k "gui/$U/com.careerboard.scan" 2>/dev/null \
        || bash "$REPO/scripts/run_scan.sh"
    else
      bash "$REPO/scripts/run_scan.sh"
    fi
    echo "Done. Watch progress with:  ./careerboard logs" ;;
  build)
    cd "$REPO" && $PY -m engine.cli build ;;
  seed)
    cd "$REPO" && $PY -m engine.cli seed
    echo "Open the board:  ./careerboard open" ;;
  status)
    echo "── scheduler ──"
    if command -v launchctl >/dev/null 2>&1; then
      launchctl list | grep careerboard || echo "(not loaded — run ./careerboard start)"
    else
      echo "(launchctl not available — see scheduler/ for cron/systemd options)"
    fi
    echo "── server ──"
    curl -s -o /dev/null -w "http://localhost:8765 → HTTP %{http_code}\n" http://localhost:8765/index.html 2>/dev/null || echo "(local server not running)"
    echo "── data ──"
    CAREERBOARD_DB="${CAREERBOARD_DB:-$ENG/careerboard.db}" $PY - <<'EOF'
import json, os, sqlite3
db = os.environ["CAREERBOARD_DB"]
if not os.path.exists(db):
    print("(empty database — run ./careerboard seed or ./careerboard now)")
else:
    c = sqlite3.connect(db)
    na = c.execute("SELECT COUNT(*) FROM applications").fetchone()[0]
    ni = c.execute("SELECT COUNT(*) FROM interviews").fetchone()[0]
    nl = c.execute("SELECT COUNT(*) FROM leads").fetchone()[0]
    cur = c.execute("SELECT value FROM kv WHERE key='last_scan_iso'").fetchone()
    print(f"applications: {na} | interviews: {ni} | leads: {nl} | last scan: {cur[0] if cur else 'never'}")
EOF
    ;;
  logs)
    tail -f "$REPO/logs/scan-$(date +%Y%m%d).log" ;;
  open)
    URL="http://localhost:8765/index.html#preview"
    if command -v open >/dev/null 2>&1; then open "$URL";
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL";
    else echo "$URL"; fi ;;
  start)
    bash "$REPO/scripts/install_launchd.sh" ;;
  stop)
    for L in server scan; do launchctl bootout "gui/$U/com.careerboard.$L" 2>/dev/null && echo "stopped $L"; done ;;
  uninstall)
    for L in server scan; do launchctl bootout "gui/$U/com.careerboard.$L" 2>/dev/null; rm -f "$HOME/Library/LaunchAgents/com.careerboard.$L.plist"; done
    echo "Agents removed. Project files left intact in $REPO." ;;
  test)
    cd "$REPO" && $PY -m unittest discover -s tests ;;
  *)
    echo "Usage: ./careerboard {now|build|seed|status|logs|open|start|stop|uninstall|test}" ;;
esac
